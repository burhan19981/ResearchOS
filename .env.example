# ResearchOS environment configuration template.
# Copy this file to `.env` and fill in real values locally.
# NEVER commit `.env` — it is excluded via .gitignore.
# This file intentionally contains no real keys or secrets.

# --- Application ---
RESEARCHOS_ENV=development
RESEARCHOS_LOG_LEVEL=INFO

# --- LLM Provider configuration (Phase 2) ---
# Leave commented out / unset until you are ready to enable real API calls.
# Values here are variable NAMES only — no real keys are stored in this
# file. Copy this file to `.env` and fill in your own credentials there;
# `.env` is gitignored and must never be committed.
#
# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-available-model-id
# ANTHROPIC_TIMEOUT_SECONDS=60
# ANTHROPIC_MAX_RETRIES=2
#
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2

# --- Database (Phase 3) ---
# Any SQLAlchemy-supported URL. Leave unset to use the default local
# SQLite file at data/researchos.db (created automatically, gitignored,
# never committed). No credentials are stored in this file.
#
# SQLite (default if unset):
# DATABASE_URL=sqlite:///data/researchos.db
#
# PostgreSQL (future — requires installing a driver, e.g. psycopg):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/researchos
#
# Set to true to log every SQL statement (verbose; local debugging only):
# RESEARCHOS_DB_ECHO=false

# --- Evidence / literature sources (Phase 5) ---
# Configuration and access requirements depend on the source.
# "Contact email" values are a courtesy identifier some sources' docs
# request for higher-rate-limit "polite pool" access; they are not
# credentials. Verify current source access requirements before live requests.
#
# OpenAlex — https://docs.openalex.org
# OPENALEX_API_URL=https://api.openalex.org
# OPENALEX_CONTACT_EMAIL=
#
# Crossref — https://api.crossref.org
# CROSSREF_API_URL=https://api.crossref.org
# CROSSREF_CONTACT_EMAIL=
#
# Semantic Scholar — https://api.semanticscholar.org/graph/v1
# SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
# SEMANTIC_SCHOLAR_API_KEY=
#
# arXiv — https://export.arxiv.org/api/query (fully public, no key/email)
# ARXIV_API_URL=https://export.arxiv.org/api/query
#
# Shared request behavior across all evidence sources:
# RESEARCHOS_EVIDENCE_TIMEOUT_SECONDS=20
# RESEARCHOS_EVIDENCE_MAX_RETRIES=3
#
# Local response cache (raw source responses; review before sharing):
# RESEARCHOS_EVIDENCE_CACHE_ENABLED=true
# RESEARCHOS_EVIDENCE_CACHE_DIR=data/cache/evidence
# RESEARCHOS_EVIDENCE_CACHE_TTL_SECONDS=86400

# --- Storage paths (defaults; override if needed) ---
RESEARCHOS_DATA_DIR=./data
RESEARCHOS_LOGS_DIR=./logs
